# Local settings for the AE 16-GPU slow-path sweep.
# Copy this file to ae.env, edit the values for your cluster, then run:
#   source ae.env
#   SWEEP_TEST_LIMIT=1 bash sweep_test_robust.sh 0

# Root that contains blitz-router, MetricsTestRunner, yaullm, and xmetric-plots.
export AE_ROOT=/path/to/artifact-root

# Model and trace inputs. TraceA, Coder, and ToolAgent use the 30B path by
# default; TraceB uses the 7B path by default. Override MODEL_PATH_TRACE_* below
# if your artifact package uses a different mapping.
export MODEL_PATH_30B=/path/to/Qwen3-30B-A3B-Instruct-2507
export MODEL_PATH_7B=/path/to/Qwen2.5-7B-Instruct
export MODEL_PATH_TRACE_A="${MODEL_PATH_30B}"
export MODEL_PATH_TRACE_B="${MODEL_PATH_7B}"
export MODEL_PATH_CODER="${MODEL_PATH_30B}"
export MODEL_PATH_MOONCAKE="${MODEL_PATH_30B}"
export DATASET_DIR=/path/to/qwen-bailian-usagetraces-anon

# Repository and runtime paths.
export WORK_DIR="${AE_ROOT}/blitz-router"
export VENV_PATH="${AE_ROOT}/yaullm/.venv"
export OUTPUT_BASE="${AE_ROOT}/slow-path-logs"

# Remote-node paths. If the two machines share the same filesystem, these
# defaults are sufficient. If not, point them to paths that exist on the remote
# SSH host.
export REMOTE_MODEL_PATH_30B="${MODEL_PATH_30B}"
export REMOTE_MODEL_PATH_7B="${MODEL_PATH_7B}"
export REMOTE_MODEL_PATH_TRACE_A="${REMOTE_MODEL_PATH_30B}"
export REMOTE_MODEL_PATH_TRACE_B="${REMOTE_MODEL_PATH_7B}"
export REMOTE_MODEL_PATH_CODER="${REMOTE_MODEL_PATH_30B}"
export REMOTE_MODEL_PATH_MOONCAKE="${REMOTE_MODEL_PATH_30B}"
export REMOTE_VENV_PATH="${VENV_PATH}"
export REMOTE_OUTPUT_BASE="${OUTPUT_BASE}"

# Two-node 16-GPU setup: 8 local GPUs plus 8 GPUs on this SSH host.
export REMOTE_HOST=your-remote-node
export REMOTE_USER=root
export REMOTE_SSH_PORT=22

# Optional knobs. TIME_IN_SEC should remain 1200 for paper-scale runs.
export TIME_IN_SEC=1200
export CARGO_JOBS="$(nproc)"
